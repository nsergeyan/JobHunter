# Copy this file to .env and fill in real values. .env is gitignored.

# LLM extraction (structured field parsing from raw postings).
# EXTRACTION_PROVIDER picks which one ExtractionMain uses: "ollama" (local, free,
# unlimited -- requires `ollama serve` running and the model pulled) or "gemini"
# (API, rate-limited on the free tier).
EXTRACTION_PROVIDER=ollama

# Ollama (local)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini API free tier. Comma-separate multiple keys to rotate across them (only
# helps if the keys are on separate projects -- a shared project shares one quota
# regardless of key count). Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_DELAY_SECONDS=4
GEMINI_MAX_DELAY_SECONDS=8

# Path to the local SQLite database file
DATABASE_PATH=data/job_scout.db

# Scraper behavior
SCRAPER_USER_AGENT=job-scout-bot/0.1 (personal project; contact: sergeyan.narek@gmail.com)
SCRAPER_MIN_DELAY_SECONDS=2
SCRAPER_MAX_DELAY_SECONDS=5
