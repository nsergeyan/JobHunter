# Copy this file to .env and fill in real values. .env is gitignored.

# LLM extraction (structured field parsing from raw postings).
# EXTRACTION_PROVIDER picks which one ExtractionMain uses: "ollama" (local, free,
# unlimited -- requires `ollama serve` running and the model pulled) or "gemini"
# (API, rate-limited on the free tier).
EXTRACTION_PROVIDER=ollama

# Ollama (local)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini API free tier. Comma-separate multiple keys to rotate across them (only
# helps if the keys are on separate projects -- a shared project shares one quota
# regardless of key count). Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MIN_DELAY_SECONDS=4
GEMINI_MAX_DELAY_SECONDS=8

# Path to the local SQLite database file
DATABASE_PATH=data/job_scout.db

# Path to the per-platform company lists the scrapers read at runtime. Edit that
# file to add or disable a company, no recompile needed.
COMPANIES_PATH=config/companies.json

# Scraper behavior
SCRAPER_USER_AGENT=job-scout-bot/0.1 (personal project; contact: https://github.com/nsergeyan)
SCRAPER_MIN_DELAY_SECONDS=2
SCRAPER_MAX_DELAY_SECONDS=5

# Retrying transient failures (429 rate limits, 5xx, dropped connections). A
# permanent failure such as a 404 from a wrong board token is never retried.
# SCRAPER_MAX_ATTEMPTS counts the first try, so 1 disables retrying entirely.
# The wait doubles from BASE each attempt, capped at MAX, unless the server
# sends its own Retry-After, which always wins.
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_RETRY_BASE_SECONDS=2
SCRAPER_RETRY_MAX_SECONDS=60

# Optional: JDK for the Gradle daemon, used by the Python orchestrator.
# Gradle 9.2 cannot run on a JDK newer than it supports ("Unsupported class file
# major version"), and Homebrew boxes usually have the newest JDK on PATH. The
# orchestrator auto-detects a JDK 21; set this only if yours lives elsewhere.
# GRADLE_JAVA_HOME=/opt/homebrew/opt/openjdk@21
