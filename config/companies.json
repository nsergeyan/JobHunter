{
  "_readme": [
    "Company lists for each ATS platform. Edited by hand, read at runtime by",
    "CompanyRegistry, so adding a company needs no recompile. Keys starting with",
    "an underscore are ignored by the loader.",
    "Every entry needs a display 'company' name plus that platform's own identifier.",
    "Verify a new identifier against the real API before adding it: a plausible",
    "looking slug can 404, or worse, silently resolve to an unrelated company."
  ],
  "_identifiers": {
    "greenhouse": "boardToken, the slug in boards-api.greenhouse.io/v1/boards/{boardToken}/jobs. Often but not always the company name.",
    "workday": "host, tenant and site. Visit the careers page: the API host gives the tenant, and {host}/en-US/{site} gives the site slug, which is usually but not always the tenant.",
    "ashby": "boardName, the slug in api.ashbyhq.com/posting-api/job-board/{boardName}. Ashby careers pages return 200 for any slug, real or not, so confirm against the API and not the HTML page.",
    "lever": "siteToken, the slug in api.lever.co/v0/postings/{siteToken}.",
    "smartrecruiters": "companyIdentifier, the slug in api.smartrecruiters.com/v1/companies/{companyIdentifier}/postings. Confirm with a real totalFound count, since a wrong slug can return 0 with no error."
  },
